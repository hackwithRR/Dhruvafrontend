rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ================= Global Helper Functions =================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isWhitelistedAdmin() {
      // CEL .replace() does not support regex character classes like [^0-9+]
      // Since the whitelist already uses the standard format, we check direct equality.
      return isSignedIn() && (
        (request.auth.token.phone_number != null &&
         request.auth.token.phone_number in ['+919148860082', '+919123456789', '+919876543210']) ||
        (request.auth.token.email != null &&
         request.auth.token.email == 'admin@dhruva.ai') ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true) ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function getIssue(issueId) {
      return get(/databases/$(database)/documents/issues/$(issueId));
    }


    function getAppeal(appealId) {
      return get(/databases/$(database)/documents/unbanAppeals/$(appealId));
    }

    function isIssueOwner(issueId) {
      let issue = get(/databases/$(database)/documents/issues/$(issueId));
      return isSignedIn() && issue != null && (
        issue.data.createdBy == request.auth.uid || 
        issue.data.userId == request.auth.uid
      );
    }

    function userIsBanned(userId) {
      // Treat a user as banned if ANY of the supported ban fields indicate suspension.
      // This prevents bypass during partial migrations (legacy shapes vs new standardized schema).
      let userDoc = get(/databases/$(database)/documents/users/$(userId));
      return userDoc != null && (
        userDoc.data.isBanned == true ||
        userDoc.data.is_banned == true || // Added for robustness
        userDoc.data.banReason != null || // Added for robustness
        userDoc.data.ban_reason != null ||
        userDoc.data.banned_at != null ||
        (userDoc.data.ban != null && userDoc.data.ban.reason != null)
      );
    }


    // ================= Users & Subcollections =================
    match /users/{userId} {

      // Admins (phone-whitelisted) can read user profile documents for email→UID resolution.
      allow read: if isWhitelistedAdmin();


      // Admins can also write under their admin domain (kept restrictive).
      allow write: if isWhitelistedAdmin();

      // Read: Allow owner to read their own document even if banned.
      // Frontend needs this to detect ban state and also show the stored ban reason.
      // This is safe because banned users still only access their own user doc.
      allow read: if isOwner(userId);

      // If a banned user can't be sure the full document is readable due to partial migrations,
      // still ensure the ban-reason fields are accessible for UI.
      allow read: if isOwner(userId) && (
        request.resource.data.keys().hasAny(['ban_reason', 'banReason', 'banned_at', 'ban']) ||
        (resource != null && resource.data.keys().hasAny(['ban_reason', 'banReason', 'banned_at', 'ban']))
      );
      
      
      // Write: Keep restrictive behavior for banned users.
      // Allow profile edits even for banned users, so the UI can update theme/subject/etc.
      // (Admin controls actual unban/ban state.)
      allow write: if isOwner(userId)
        && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBanned']) == false);





      // AI PYQ history / caches
      match /pyqAiByChapter/{docId} {
        allow read, write: if isWhitelistedAdmin();
        allow read, write: if isOwner(userId);
      }


      match /pyqAiCacheFlat/{docId} {
        allow read, write: if isWhitelistedAdmin();
        allow read, write: if isOwner(userId) && !userIsBanned(userId);
      }

      match /pyqAiCache/{board}/{classLevel}/{subject}/{chapter}/cache {
        allow read, write: if isWhitelistedAdmin();
        allow read, write: if isOwner(userId) && !userIsBanned(userId);
      }

      // AI generation sessions
      match /pyqAiByChapter/{docId}/sessions/{sessionId} {
        allow read, write: if isWhitelistedAdmin();
        allow read, write: if isOwner(userId) && !userIsBanned(userId);
      }

      // legacy/chat sessions under users/{userId}
      // Needed because Chat.jsx queries `collection(db, `users/${uid}/sessions`)`.
      match /sessions {
        allow list: if isWhitelistedAdmin();
        allow read: if isWhitelistedAdmin();
        allow list: if isOwner(userId);
        allow read: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read, write: if isWhitelistedAdmin();
        allow read, write: if isOwner(userId);
      }



    }

    // ========= Messaging (generic) =========
    match /messages/{messageId} {
      allow read, write: if isSignedIn() && (
        (resource == null || resource.data.userId == request.auth.uid) ||
        (request.resource.data.userId == request.auth.uid)
      );
    }

    // ========= Admin =========
    match /adminUsers/{userId} {
      allow read, write: if isWhitelistedAdmin();
    }

    match /adminSessions/{sessionId} {
      allow read, write: if isWhitelistedAdmin();
    }

    match /adminConfig/{doc} {
      allow read, write: if isWhitelistedAdmin();
    }

    // ========= Unban Appeals =========
    // Structure (better approach):
    // - unbanAppeals/{appealId} holds main appeal doc
    // - unbanAppeals/{appealId}/followUps/items holds follow-up docs
    match /unbanAppeals/{appealId} {
      allow read: if isWhitelistedAdmin();

      // Users can read their own appeals (so they can see status if you implement later)
      allow read: if isSignedIn() && resource != null && resource.data.createdBy == request.auth.uid;

      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isWhitelistedAdmin();
      allow delete: if isWhitelistedAdmin();

      // Recursively wire all subcollections (followUps, items, messages)
      match /{allSubcollections=**} {
        allow read, list, create: if isWhitelistedAdmin() || (isSignedIn() && getAppeal(appealId).data.createdBy == request.auth.uid);
        // Allow users to update message metadata (seen/read status) for sync
        allow update: if isWhitelistedAdmin() || (isSignedIn() && getAppeal(appealId).data.createdBy == request.auth.uid);
        allow delete: if isWhitelistedAdmin();
      }
    }

    // ========= Issues =========

    match /issues/{issueId} {
      // Read: only the owner (createdBy) or admin
      allow read: if isSignedIn() && (isWhitelistedAdmin() || resource.data.createdBy == request.auth.uid);

      // Create:
      // - Normal users can only create issues for themselves
      // - Admins can create issues for any student (createdBy can be student uid)
      allow create: if isSignedIn() && (
        isWhitelistedAdmin() || request.resource.data.createdBy == request.auth.uid
      );

      // Update/Delete:
      // - Admin can update/delete any issue
      // - Users can update only to reopen their own closed ticket (set status -> open)
      allow update, delete: if isWhitelistedAdmin();

      // Allow ONLY setting status -> open for the owner.
      // (Prevents updates to other fields from being blocked.)
      allow update: if !isWhitelistedAdmin() && isSignedIn() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // Follow-up messages for an issue thread
    // NOTE: Messages written by the app use { role: 'user'|'admin', text, createdAt, screenshotUrl }
    // There is NO `userId` field written in IssueThreadWindow/TicketsSection.
    // So permission is derived from parent issue ownership.
    match /issues/{issueId}/messages/{messageId} {
      allow read: if isSignedIn() && (
        isWhitelistedAdmin() ||
        get(/databases/$(database)/documents/issues/$(issueId)).data.createdBy == request.auth.uid
      );

      allow create: if isSignedIn() && (
        // Admin can always write
        isWhitelistedAdmin() ||
        // Users can write only if they own the parent issue
        get(/databases/$(database)/documents/issues/$(issueId)).data.createdBy == request.auth.uid
      );

      allow update, delete: if isWhitelistedAdmin();
    }

    // ========= Syllabus Materials (Base64) =========
    match /syllabus_metadata/{materialId} {
      allow read: if isSignedIn();
      allow write: if isWhitelistedAdmin();

      // Allow read/write for history subcollection only by admins
      // This is for archiving previous versions
      match /history/{historyId} {
        allow read, write: if isWhitelistedAdmin();
      }
    }
  }
}
